<section class="chic-home color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="chic-home__categories">
      <p class="chic-eyebrow">Shop by nail style</p>
      <h2 class="chic-section-title">{{ section.settings.category_heading }}</h2>
      <div class="chic-grid chic-grid--4">
        <a class="chic-home__tile chic-card" href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}">
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <strong>Short</strong>
          <small>Everyday length</small>
        </a>
        <a class="chic-home__tile chic-card" href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}">
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <strong>Almond</strong>
          <small>Soft tapered shape</small>
        </a>
        <a class="chic-home__tile chic-card" href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}">
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <strong>Square</strong>
          <small>Clean edge</small>
        </a>
        <a class="chic-home__tile chic-card" href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}">
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <strong>Custom</strong>
          <small>Coming later</small>
        </a>
      </div>
    </div>

    <div class="chic-home__promos chic-grid chic-grid--3">
      <div class="chic-home__promo chic-card">
        <p class="chic-eyebrow">Quick order</p>
        <h3>{{ section.settings.quick_heading }}</h3>
        <p class="chic-copy">{{ section.settings.quick_text }}</p>
        <a class="button" href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}">Shop all</a>
      </div>
      <div class="chic-home__promo chic-card">
        <p class="chic-eyebrow">Customer looks</p>
        <h3>Real manicures, real routines</h3>
        <div class="chic-home__ugc chic-grid chic-grid--3" aria-hidden="true">
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
          <span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span>
        </div>
      </div>
      <div class="chic-home__promo chic-card">
        <p class="chic-eyebrow">In every kit</p>
        <h3>Prep, apply, repeat</h3>
        <p class="chic-copy">Nail set, glue, mini file, cuticle stick, prep pad, and an easy application guide.</p>
      </div>
    </div>

    <div class="chic-home__story chic-grid chic-grid--2">
      <div class="chic-home__panel chic-card">
        <p class="chic-eyebrow">New series</p>
        <h3>Seasonal drops and Chinese-inspired customs</h3>
        <p class="chic-copy">Reserved for holiday launches, limited styles, and future custom requests without changing the page structure.</p>
      </div>
      <div class="chic-home__panel chic-card chic-faq">
        <p class="chic-eyebrow">FAQ preview</p>
        <details open>
          <summary>How long do press-on nails last?</summary>
          <p>Glue application is positioned for longer wear, while adhesive tabs work well for short-term looks and easy changes.</p>
        </details>
        <details>
          <summary>What is included in a nail kit?</summary>
          <p>Use this area to confirm nails, glue, prep pad, mini file, cuticle stick, and instructions.</p>
        </details>
        <details>
          <summary>Can I request a custom style?</summary>
          <p>Custom requests can be collected through a dedicated form after the backend flow is ready.</p>
        </details>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .chic-home {
    padding: 5.6rem 0;
  }

  .chic-home__categories {
    text-align: center;
  }

  .chic-home__tile {
    display: grid;
    gap: 0.8rem;
    padding-bottom: 1.4rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .chic-home__tile .chic-placeholder {
    min-height: 20rem;
    border-left: 0;
    border-right: 0;
    border-top: 0;
  }

	  .chic-home__tile strong,
	  .chic-home__promo h3,
	  .chic-home__panel h3 {
	    color: var(--chic-ink);
	    font-weight: var(--chic-ui-weight);
	  }

  .chic-home__tile strong {
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chic-home__tile small {
    color: var(--chic-muted);
    font-size: 1.2rem;
  }

  .chic-home__promos,
  .chic-home__story {
    margin-top: 4rem;
  }

  .chic-home__promo,
  .chic-home__panel {
    min-height: 28rem;
    padding: 2.4rem;
  }

  .chic-home__promo h3,
  .chic-home__panel h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 3rem;
    line-height: 1;
  }

  .chic-home__promo .button {
    margin-top: 2rem;
  }

  .chic-home__ugc {
    margin-top: 2rem;
  }

  .chic-home__ugc .chic-placeholder {
    min-height: 15rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic home content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "category_heading",
      "label": "Category heading",
      "default": "Find your next manicure"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link"
    },
    {
      "type": "text",
      "id": "quick_heading",
      "label": "Quick order heading",
      "default": "Ready in minutes"
    },
    {
      "type": "textarea",
      "id": "quick_text",
      "label": "Quick order text",
      "default": "Make repeat purchases easy with best sellers, new arrivals, and add-to-bag cards close together."
    }
  ],
  "presets": [
    {
      "name": "Chic home content"
    }
  ]
}
{% endschema %}
