<section class="chic-home color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="chic-brand-band" aria-label="{{ section.settings.band_label | escape }}">
      <span>{{ section.settings.band_item_1 | escape }}</span>
      <span>{{ section.settings.band_item_2 | escape }}</span>
      <span>{{ section.settings.band_item_3 | escape }}</span>
      <span>{{ section.settings.band_item_4 | escape }}</span>
    </div>

    <div class="chic-home__section-head">
      <p class="chic-eyebrow">{{ section.settings.category_eyebrow | escape }}</p>
      <h2 class="chic-section-title">{{ section.settings.category_heading | escape }}</h2>
      <p class="chic-copy">{{ section.settings.category_text | escape }}</p>
    </div>

    <div class="chic-shape-grid" aria-label="{{ section.settings.category_heading | escape }}">
      <a class="chic-shape-tile chic-card" href="{{ section.settings.square_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--square"></span>
        <strong>Square</strong>
        <small>Clean edge</small>
      </a>
      <a class="chic-shape-tile chic-card" href="{{ section.settings.squoval_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--squoval"></span>
        <strong>Squoval</strong>
        <small>Soft square</small>
      </a>
      <a class="chic-shape-tile chic-card" href="{{ section.settings.short_almond_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--short-almond"></span>
        <strong>Short Almond</strong>
        <small>Everyday taper</small>
      </a>
      <a class="chic-shape-tile chic-card" href="{{ section.settings.long_almond_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--long-almond"></span>
        <strong>Long Almond</strong>
        <small>Elongated soft</small>
      </a>
      <a class="chic-shape-tile chic-card" href="{{ section.settings.coffin_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--coffin"></span>
        <strong>Coffin</strong>
        <small>Tapered square</small>
      </a>
      <a class="chic-shape-tile chic-card" href="{{ section.settings.stiletto_link | default: routes.all_products_collection_url }}">
        <span class="chic-shape-tile__mark chic-shape-tile__mark--stiletto"></span>
        <strong>Stiletto</strong>
        <small>Pointed finish</small>
      </a>
    </div>

    <div class="chic-story-grid">
      <div class="chic-story-panel chic-card">
        <p class="chic-eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        <h2>{{ section.settings.story_heading | escape }}</h2>
        <p>{{ section.settings.story_text | escape }}</p>
        <a class="button button--secondary" href="{{ section.settings.story_link | default: routes.all_products_collection_url }}">
          {{ section.settings.story_button | escape }}
        </a>
      </div>

      <div class="chic-how chic-card">
        <div class="chic-how__head">
          <p class="chic-eyebrow">{{ section.settings.how_eyebrow | escape }}</p>
          <h2>{{ section.settings.how_heading | escape }}</h2>
        </div>
        <ol class="chic-how__steps">
          <li>
            <span>01</span>
            <strong>{{ section.settings.step_1_title | escape }}</strong>
            <p>{{ section.settings.step_1_text | escape }}</p>
          </li>
          <li>
            <span>02</span>
            <strong>{{ section.settings.step_2_title | escape }}</strong>
            <p>{{ section.settings.step_2_text | escape }}</p>
          </li>
          <li>
            <span>03</span>
            <strong>{{ section.settings.step_3_title | escape }}</strong>
            <p>{{ section.settings.step_3_text | escape }}</p>
          </li>
          <li>
            <span>04</span>
            <strong>{{ section.settings.step_4_title | escape }}</strong>
            <p>{{ section.settings.step_4_text | escape }}</p>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .chic-brand-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: clamp(5.2rem, 6vw, 8rem);
    overflow: hidden;
    border: 1px solid var(--chic-line-strong);
    border-radius: var(--chic-radius-sm);
    background: var(--chic-cocoa);
    box-shadow: var(--chic-shadow-soft);
  }

  .chic-brand-band span {
    display: grid;
    min-height: 7.2rem;
    place-items: center;
    padding: 1.6rem;
    background: rgba(255, 253, 252, 0.92);
    color: var(--chic-cocoa);
    font-size: 1.1rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }

  .chic-home__section-head {
    display: grid;
    justify-items: center;
    max-width: 68rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }

  .chic-home__section-head .chic-copy {
    max-width: 52rem;
    margin: 0;
  }

  .chic-shape-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .chic-shape-tile {
    display: grid;
    gap: 0.8rem;
    min-height: 19rem;
    align-content: center;
    justify-items: center;
    padding: 1.8rem 1.2rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .chic-shape-tile:hover {
    box-shadow: var(--chic-shadow-deep);
    transform: translateY(-0.2rem);
  }

  .chic-shape-tile__mark {
    display: block;
    width: 4.2rem;
    height: 8.8rem;
    border: 1px solid rgba(91, 44, 47, 0.24);
    background:
      linear-gradient(180deg, rgba(255,255,255,.65), rgba(234,193,178,.48)),
      var(--chic-paper);
    box-shadow: inset 0 0 0 0.6rem rgba(255, 253, 252, 0.38);
  }

  .chic-shape-tile__mark--square {
    border-radius: 1.2rem 1.2rem 0.5rem 0.5rem;
  }

  .chic-shape-tile__mark--squoval {
    border-radius: 2rem 2rem 1rem 1rem;
  }

  .chic-shape-tile__mark--short-almond {
    height: 7.6rem;
    border-radius: 999px 999px 2.4rem 2.4rem;
  }

  .chic-shape-tile__mark--long-almond {
    height: 9.8rem;
    border-radius: 999px 999px 2.6rem 2.6rem;
  }

  .chic-shape-tile__mark--coffin {
    clip-path: polygon(18% 0, 82% 0, 100% 100%, 0 100%);
    border-radius: 0.9rem 0.9rem 0.4rem 0.4rem;
  }

  .chic-shape-tile__mark--stiletto {
    clip-path: polygon(50% 0, 94% 42%, 76% 100%, 24% 100%, 6% 42%);
    border-radius: 2rem;
  }

  .chic-shape-tile strong {
    color: var(--chic-ink);
    font-size: 1.2rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chic-shape-tile small {
    color: var(--chic-muted);
    font-size: 1.2rem;
  }

  .chic-story-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.6rem;
    margin-top: clamp(5.2rem, 6vw, 8rem);
  }

  .chic-story-panel,
  .chic-how {
    padding: clamp(2.4rem, 4vw, 4.2rem);
  }

  .chic-story-panel {
    display: flex;
    min-height: 44rem;
    flex-direction: column;
    justify-content: flex-end;
    background:
      radial-gradient(circle at 22% 18%, rgba(234, 193, 178, 0.34), transparent 28%),
      rgba(255, 253, 252, 0.78);
  }

  .chic-story-panel h2,
  .chic-how h2 {
    max-width: 50rem;
    margin: 0;
    color: var(--chic-cocoa);
    font-family: var(--font-heading-family);
    font-size: clamp(3.8rem, 5vw, 6.8rem);
    font-weight: var(--chic-serif-weight);
    letter-spacing: 0;
    line-height: 0.92;
  }

  .chic-story-panel p:not(.chic-eyebrow) {
    max-width: 42rem;
    color: var(--chic-muted);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .chic-story-panel .button {
    align-self: flex-start;
    margin-top: 1.4rem;
  }

  .chic-how__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 3.2rem 0 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--chic-line);
    border-radius: var(--chic-radius-sm);
    background: var(--chic-line);
    list-style: none;
  }

  .chic-how__steps li {
    min-height: 18rem;
    padding: 2.2rem;
    background: rgba(255, 253, 252, 0.86);
  }

  .chic-how__steps span {
    color: var(--chic-merlot);
    font-size: 1rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.18em;
  }

  .chic-how__steps strong {
    display: block;
    margin-top: 3.2rem;
    color: var(--chic-ink);
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: var(--chic-serif-weight);
    line-height: 1;
  }

  .chic-how__steps p {
    margin: 0.8rem 0 0;
    color: var(--chic-muted);
    font-size: 1.35rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .chic-brand-band,
    .chic-shape-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chic-story-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .chic-brand-band,
    .chic-shape-grid,
    .chic-how__steps {
      grid-template-columns: 1fr;
    }

    .chic-story-panel {
      min-height: 34rem;
    }
  }
{% endstylesheet %}

