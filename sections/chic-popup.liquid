{%- liquid
  assign code = section.settings.discount_code | default: 'WELCOME15'
-%}
<chic-popup
  class="chic-popup"
  data-delay="{{ section.settings.delay | times: 1000 }}"
  {% if request.design_mode %}data-design-mode="true"{% endif %}
  hidden
>
  <div class="chic-popup__overlay" data-popup-close></div>
  <div class="chic-popup__dialog" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
    <button type="button" class="chic-popup__close" aria-label="Close" data-popup-close>&times;</button>
    <div class="chic-popup__inner color-{{ section.settings.color_scheme }}">
      {% if section.settings.eyebrow != blank %}<p class="chic-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="chic-popup__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subtext != blank %}<div class="chic-popup__text rte">{{ section.settings.subtext }}</div>{% endif %}

      {%- form 'customer', class: 'chic-popup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        {%- if form.posted_successfully? -%}
          <p class="chic-popup__success">{{ section.settings.success_text | replace: '[CODE]', code }}</p>
        {%- else -%}
          <div class="chic-popup__field">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
          </div>
          {%- if form.errors -%}
            <p class="chic-popup__error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <button type="button" class="chic-popup__decline" data-popup-close>{{ section.settings.decline_label | escape }}</button>
    </div>
  </div>
</chic-popup>

{% stylesheet %}
  .chic-popup[hidden] { display: none; }
  .chic-popup {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 2rem;
  }
  .chic-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.55);
  }
  .chic-popup__dialog {
    position: relative;
    width: min(44rem, 100%);
    background: #fff;
    box-shadow: 0 20px 60px rgba(26, 26, 26, 0.28);
  }
  .chic-popup__inner {
    padding: 4rem 3.2rem 3.2rem;
    text-align: center;
  }
  .chic-popup__close {
    position: absolute;
    top: 0.8rem;
    right: 1.2rem;
    background: none;
    border: 0;
    font-size: 2.8rem;
    line-height: 1;
    cursor: pointer;
    color: var(--chic-ink);
  }
  .chic-popup__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .chic-popup__text {
    color: var(--chic-muted);
    margin-bottom: 2rem;
    font-size: 1.4rem;
  }
  .chic-popup__field {
    display: grid;
    gap: 1rem;
  }
  .chic-popup__field input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.4rem;
    border: 1px solid var(--chic-border);
    background: #fff;
    font-size: 1.4rem;
  }
  .chic-popup__form .button {
    width: 100%;
  }
  .chic-popup__success {
    font-size: 1.6rem;
    font-weight: var(--chic-ui-weight);
    letter-spacing: 0.04em;
  }
  .chic-popup__error {
    color: #b00020;
    font-size: 1.2rem;
    margin-top: 0.8rem;
  }
  .chic-popup__decline {
    display: inline-block;
    margin-top: 1.6rem;
    background: none;
    border: 0;
    color: var(--chic-muted);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    cursor: pointer;
  }
{% endstylesheet %}

<script>
  (function () {
    class ChicPopup extends HTMLElement {
      constructor() {
        super();
        this.key = 'chic_popup_dismissed';
        this.dialog = this.querySelector('.chic-popup__dialog');
      }
      connectedCallback() {
        this.querySelectorAll('[data-popup-close]').forEach((el) =>
          el.addEventListener('click', () => this.close())
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') this.close();
        });
        // Keep open after a successful submit so the code shows.
        if (this.querySelector('.chic-popup__success')) {
          this.open();
          return;
        }
        if (this.hasAttribute('data-design-mode')) {
          this.open();
          return;
        }
        if (this.dismissed()) return;
        const delay = parseInt(this.getAttribute('data-delay'), 10) || 1500;
        this.timer = setTimeout(() => this.open(), delay);
      }
      dismissed() {
        try { return localStorage.getItem(this.key) === '1'; } catch (e) { return false; }
      }
      open() { this.removeAttribute('hidden'); }
      close() {
        this.setAttribute('hidden', '');
        try { localStorage.setItem(this.key, '1'); } catch (e) {}
        if (this.timer) clearTimeout(this.timer);
      }
    }
    if (!customElements.get('chic-popup')) customElements.define('chic-popup', ChicPopup);
  })();
</script>

{% schema %}
{
  "name": "Chic popup",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIRST ORDER OFFER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "15% OFF YOUR FIRST ORDER"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Join the VIP list for exclusive deals, new launches, and nail inspo.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET 15% OFF"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code shown on success",
      "default": "WELCOME15"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message ([CODE] is replaced)",
      "default": "You are in! Use code [CODE] for 15% off your first order."
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline label",
      "default": "No thanks"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay before showing (seconds)",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    { "name": "Chic popup" }
  ]
}
{% endschema %}
