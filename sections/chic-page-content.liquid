{%- liquid
  assign is_about_page = false
  if page.handle == 'about-us'
    assign is_about_page = true
  endif

  assign about_heading = section.settings.about_heading | default: page.title
  assign about_intro = section.settings.about_intro | default: 'Some mornings you wake up soft. Some mornings you wake up fire. Your nails should be able to keep up.'
-%}

<section
  class="chic-page{% if is_about_page %} chic-page--about{% endif %} color-{{ section.settings.color_scheme }} gradient"
  {% if is_about_page %}
    style="
      --chic-about-background: {{ section.settings.about_background }};
      --chic-about-text: {{ section.settings.about_text_color }};
      --chic-about-spacing: {{ section.settings.about_spacing }}px;
      --chic-about-align: {{ section.settings.about_alignment }};
    "
  {% endif %}
>
  <div class="chic-page__masthead{% if is_about_page %} chic-page__masthead--about{% endif %}">
    <div class="page-width{% if is_about_page %} chic-page__about-hero{% endif %}">
      {% if is_about_page %}
        <div>
          <h1 class="chic-heading">{{ about_heading | escape }}</h1>
        </div>
        <p class="chic-copy">{{ about_intro | escape }}</p>
      {% else %}
        <h1 class="chic-heading">{{ page.title | escape }}</h1>
        <p class="chic-copy">
          {% case page.handle %}
            {% when 'how-to-apply' %}
              Three application routes for press-on nails: glue, adhesive tabs, and a combined method for stronger wear.
            {% when 'faq' %}
              Quick answers for sizing, application, removal, kits, shipping, and VIP signup.
            {% when 'rewards' %}
              A front-end loyalty hub for account creation, points, rewards, referrals, and early access.
            {% else %}
              {{ page.content | strip_html | truncate: 180 }}
          {% endcase %}
        </p>
      {% endif %}
    </div>
  </div>

  <div class="page-width chic-page__body">
    {% case page.handle %}
      {% when 'how-to-apply' %}
        <nav class="chic-page__tabs" aria-label="Application methods">
          <a href="#glue">Glue application</a>
          <a href="#tabs">Adhesive tabs</a>
          <a href="#combo">Glue + tabs</a>
        </nav>

        <div class="chic-grid chic-grid--4 chic-page__icons">
          <details class="chic-card chic-icon-details" open>
            <summary><span class="chic-icon">1</span><strong>Prep</strong></summary>
            <p>Clean hands, push back cuticles, lightly buff the nail surface, and wipe away oils.</p>
          </details>
          <details class="chic-card chic-icon-details">
            <summary><span class="chic-icon">2</span><strong>Size</strong></summary>
            <p>Match each press-on to your natural nail. If between sizes, choose larger and gently file.</p>
          </details>
          <details class="chic-card chic-icon-details">
            <summary><span class="chic-icon">3</span><strong>Apply</strong></summary>
            <p>Use glue or tabs depending on wear goal, then press from the cuticle line forward.</p>
          </details>
          <details class="chic-card chic-icon-details">
            <summary><span class="chic-icon">4</span><strong>Finish</strong></summary>
            <p>Hold firmly for a secure fit and avoid water immediately after application.</p>
          </details>
        </div>

        <div class="chic-page__steps" id="glue">
          <h2 class="chic-section-title">Glue application</h2>
          <div class="chic-grid chic-grid--3">
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Prep the nail</strong><p>Remove old polish, trim natural nails, push cuticles back, buff lightly, and cleanse.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Add glue</strong><p>Apply a thin layer to your natural nail and the press-on. Use less glue for shorter wear, more for longer wear.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Press and hold</strong><p>Apply at a slight downward angle and hold for 10-20 seconds until secure.</p></div></article>
          </div>
        </div>

        <div class="chic-page__steps" id="tabs">
          <h2 class="chic-section-title">Adhesive tab application</h2>
          <div class="chic-grid chic-grid--3">
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Choose tab size</strong><p>Select the closest tab for each nail and press it onto the natural nail.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Peel backing</strong><p>Remove the backing without touching the adhesive surface.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Apply press-on</strong><p>Press the nail down firmly for a temporary manicure that is easier to remove.</p></div></article>
          </div>
        </div>

        <div class="chic-page__steps" id="combo">
          <h2 class="chic-section-title">Glue + adhesive tabs</h2>
          <div class="chic-grid chic-grid--3">
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Start with tabs</strong><p>Place the adhesive tab first to create a protective base layer.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Add glue</strong><p>Apply glue over the tab and onto the press-on for a stronger hold.</p></div></article>
            <article class="chic-card"><span class="chic-placeholder"><img src="{{ 'chic-nail-placeholder.svg' | asset_url }}" alt="" loading="lazy" width="1200" height="1200"></span><div><strong>Secure fit</strong><p>Press firmly and keep hands dry while the bond settles.</p></div></article>
          </div>
        </div>

      {% when 'faq' %}
        <div class="chic-page__faq-layout">
          <aside>
            <a href="#product-material">Product & Material</a>
            <a href="#wear-application">Wear & Application</a>
            <a href="#removal-reuse">Removal & Reuse</a>
            <a href="#troubleshooting">Troubleshooting</a>
            <a href="#orders-shipping">Orders & Shipping</a>
          </aside>
          <div class="chic-faq">
            <h2 id="product-material" class="chic-section-title">Product & Material</h2>
            <details open>
              <summary>What are Zora press-on nails made of?</summary>
              <p>Every Zora set is crafted from soft jelly gel - the same gel used in professional salons - hand-layered and cured, not printed. The result is a translucent, glassy shine and a flexible, second-skin feel that rigid plastic press-ons simply can't match.</p>
            </details>
            <details>
              <summary>How are Zora nails different from cheap press-ons?</summary>
              <p>Cheaper press-ons use printed designs on hard plastic that look flat and feel bulky. Zora's jelly gel is built up by hand in layers, giving real depth, a soft bendable fit, and a finish that reads as a fresh salon manicure - not a costume.</p>
            </details>
            <details>
              <summary>Are Zora nails vegan and cruelty-free?</summary>
              <p>Yes. All Zora nails and adhesives are vegan, cruelty-free, and free from harsh, damaging chemicals.</p>
            </details>

            <h2 id="wear-application" class="chic-section-title">Wear & Application</h2>
            <details open>
              <summary>How long do Zora nails last?</summary>
              <p>With proper prep, Zora nails last up to 1-2 weeks, and many customers get even longer. Wear time depends on your nail prep, correct sizing, and your daily activities.</p>
            </details>
            <details>
              <summary>How do I apply them?</summary>
              <p>Clean and buff your natural nails, push back cuticles, and wipe with the prep pad to remove all oils. Select the size that fits each nail bed without touching the skin. Apply a thin layer of glue to both your nail and the press-on, then press down firmly and hold for 15-30 seconds. Avoid water for the first hour.</p>
            </details>
            <details>
              <summary>Should I use glue or adhesive tabs?</summary>
              <p>For long wear, up to 2 weeks, use the nail glue. For a quick look you'll change in a day or two - or for a gentler, no-glue option - use the adhesive tabs. You can also layer tabs with a little glue for extra hold.</p>
            </details>
            <details>
              <summary>Can I trim or file them?</summary>
              <p>You can gently file them to reshape or shorten. We recommend filing rather than cutting, and waiting about an hour after application so the bond is fully set.</p>
            </details>
            <details>
              <summary>Are Zora nails waterproof? Can I shower or swim?</summary>
              <p>Once fully set, about 1 hour after application, Zora nails hold up to everyday water - showering, washing dishes, and hand-washing. For best longevity, avoid long soaks and very hot water, and dry your hands well.</p>
            </details>

            <h2 id="removal-reuse" class="chic-section-title">Removal & Reuse</h2>
            <details open>
              <summary>How do I remove them without damaging my nails?</summary>
              <p>Never pull or force them off. Soak your nails in warm soapy water with a few drops of oil for 10-15 minutes to loosen the bond, then gently lift from the side edge with the cuticle stick. Go slowly. Follow with cuticle oil.</p>
            </details>
            <details>
              <summary>Are Zora nails reusable?</summary>
              <p>Yes - if you remove them gently and store them in their original tray. Clean off any leftover glue from the back before storing. One set can be re-worn several times, which makes Zora better value than single-use nails.</p>
            </details>
            <details>
              <summary>Will press-ons damage my natural nails?</summary>
              <p>No - when applied and removed correctly, Zora nails won't damage your natural nails. Damage almost always comes from pulling nails off by force. Always soak and lift gently.</p>
            </details>

            <h2 id="troubleshooting" class="chic-section-title">Troubleshooting</h2>
            <details open>
              <summary>Why didn't my nails last long?</summary>
              <p>Short wear time is almost always caused by one of three things: your natural nails weren't fully prepped, you chose a size that's too large or too small, or you exposed the nails to water or heavy use too soon. Oils and moisture are the number one enemy. Let them set for the first hour, and use glue rather than tabs for longest wear.</p>
            </details>
            <details>
              <summary>What if my nails feel uncomfortable or tight?</summary>
              <p>Zora nails should feel comfortable and natural. If they feel tight or press on your cuticles, you may need a smaller size. If they press on the sides, you can gently file the inner edge of the press-on to widen it slightly. Never force a nail into place - it shouldn't hurt.</p>
            </details>
            <details>
              <summary>I see a greenish tint on my natural nail - what is it?</summary>
              <p>This is called a "greenie" - a harmless discoloration caused by a small amount of trapped moisture between your natural nail and the press-on. It's not dangerous, but we recommend removing the nails, letting your nails breathe for a few days, and applying a base coat before your next wear.</p>
            </details>

            <h2 id="orders-shipping" class="chic-section-title">Orders & Shipping</h2>
            <details open>
              <summary>How do I track my order?</summary>
              <p>Once your order ships, we'll email you a tracking link.</p>
            </details>
            <details>
              <summary>How do I contact you?</summary>
              <p>Email us anytime at hello@zoranails.com. We typically reply within 1-2 business days.</p>
            </details>
          </div>
        </div>

      {% when 'about-us' %}
        <div class="chic-page__about-layout">
          <aside class="chic-page__about-aside">
            <span class="chic-page__about-aside-label">{{ section.settings.about_aside_label | escape }}</span>
            <span class="chic-page__about-aside-rule" aria-hidden="true"></span>
            <p class="chic-page__about-script">{{ section.settings.about_script | escape | newline_to_br }}</p>
          </aside>

          <article class="chic-page__about-copy">
            <p class="chic-page__about-lead">{{ section.settings.about_intro | escape }}</p>
            <p>{{ section.settings.about_body_1 | escape }}</p>
            <p>{{ section.settings.about_body_2 | escape }}</p>
            <blockquote class="chic-page__about-quote">{{ section.settings.about_pull_quote | escape }}</blockquote>
            <p class="chic-page__about-closing">
              <span aria-hidden="true"></span>
              <em>{{ section.settings.about_closing_line | escape }}</em>
            </p>
          </article>
        </div>

      {% when 'rewards' %}
        <div class="chic-grid chic-grid--4 chic-page__icons">
          <details class="chic-card chic-icon-details" open><summary><span class="chic-icon">1</span><strong>Create account</strong></summary><p>Front-end entry for account creation and rewards status.</p></details>
          <details class="chic-card chic-icon-details"><summary><span class="chic-icon">2</span><strong>Earn points</strong></summary><p>Purchases, reviews, referrals, and signup actions can become earn rules after backend setup.</p></details>
          <details class="chic-card chic-icon-details"><summary><span class="chic-icon">3</span><strong>Redeem</strong></summary><p>Reserved for discounts, gifts, free shipping, and early-access rewards.</p></details>
          <details class="chic-card chic-icon-details"><summary><span class="chic-icon">4</span><strong>Refer friends</strong></summary><p>Referral content can connect to the selected loyalty app later.</p></details>
        </div>
        <div class="chic-page__reward chic-card">
          <p class="chic-eyebrow">VIP signup</p>
          <h2 class="chic-section-title">Get launch alerts and exclusive offers</h2>
          <p class="chic-copy">This front-end page reserves the loyalty and VIP experience; backend will decide the final app and data rules.</p>
          <a class="button" href="{{ routes.account_register_url }}">Create account</a>
        </div>

      {% else %}
        <div class="page-width--narrow rte">{{ page.content }}</div>
    {% endcase %}
  </div>
</section>

{% stylesheet %}
  .chic-page__masthead {
    padding: clamp(3.2rem, 5vw, 6.4rem) 0 clamp(2.4rem, 4vw, 4.8rem);
    border-bottom: 1px solid var(--chic-line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 100%),
      var(--chic-paper);
  }

  .chic-page__masthead .page-width {
    display: grid;
    justify-items: start;
  }

  .chic-page__masthead .chic-heading {
    max-width: 72rem;
  }

  .chic-page__masthead .chic-copy {
    max-width: 62rem;
    margin: 1.6rem 0 0;
  }

  .chic-page--about {
    color: var(--chic-about-text, var(--chic-ink));
    background:
      radial-gradient(circle at 88% 0%, rgba(234, 193, 178, 0.16), transparent 22%),
      linear-gradient(180deg, var(--chic-about-background, var(--chic-paper)), var(--chic-white) 48%, var(--chic-paper) 100%);
  }

  .chic-page__masthead--about {
    padding: clamp(5.4rem, 7vw, 8.8rem) 0 clamp(4.2rem, 5.8vw, 6.8rem);
    background:
      radial-gradient(circle at 82% 12%, rgba(176, 120, 128, 0.11), transparent 24%),
      linear-gradient(180deg, rgba(255, 253, 252, 0.54), transparent 100%);
  }

  .chic-page__about-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(32rem, 1.18fr);
    gap: clamp(3.6rem, 7vw, 8rem);
    align-items: end;
  }

  .chic-page__masthead--about .chic-heading {
    max-width: 58rem;
    font-size: clamp(5.8rem, 8vw, 10.4rem);
    line-height: 0.86;
  }

  .chic-page__masthead--about .chic-copy {
    max-width: 52rem;
    margin: 0 0 0.6rem;
    color: var(--chic-muted);
    font-size: clamp(1.55rem, 1.3vw, 1.75rem);
    line-height: 1.75;
  }

  .chic-page__body {
    padding-top: 5.6rem;
    padding-bottom: 5.6rem;
  }

  .chic-page__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-bottom: 4rem;
  }

  .chic-page__tabs a,
  .chic-page__faq-layout aside a {
    padding: 1.4rem;
	    border: 1px solid var(--chic-border);
	    color: var(--chic-ink);
	    font-size: 1.2rem;
	    font-weight: var(--chic-ui-weight);
	    letter-spacing: 0.12em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .chic-page__icons {
    margin-bottom: 4.8rem;
  }

  .chic-page__steps + .chic-page__steps {
    margin-top: 5.6rem;
  }

  .chic-page__steps article > div {
    padding: 1.8rem;
  }

  .chic-page__steps strong {
	    display: block;
	    margin-bottom: 0.8rem;
	    color: var(--chic-ink);
	    font-weight: var(--chic-ui-weight);
	    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .chic-page__steps p {
    margin: 0;
    color: var(--chic-muted);
    font-size: 1.4rem;
    line-height: 1.55;
  }

  .chic-page__faq-layout {
    display: grid;
    grid-template-columns: 24rem 1fr;
    gap: 4rem;
  }

  .chic-page__faq-layout aside {
    position: sticky;
    top: 10rem;
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .chic-faq .chic-section-title {
    margin-top: 4rem;
    text-align: left;
  }

  .chic-faq .chic-section-title:first-child {
    margin-top: 0;
  }

  .chic-page__story {
    min-height: 30rem;
    padding: 2.8rem;
  }

  .chic-page__story .chic-section-title,
  .chic-page__reward .chic-section-title {
    text-align: left;
  }

  .chic-page--about .chic-page__body {
    padding-top: var(--chic-about-spacing, 88px);
    padding-bottom: clamp(7rem, 9vw, 11rem);
  }

  .chic-page__about-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 24rem) minmax(0, 1fr);
    gap: clamp(4rem, 6vw, 7.2rem);
    align-items: start;
    max-width: 108rem;
    margin: 0 auto;
  }

  .chic-page__about-aside {
    position: sticky;
    top: 11rem;
    color: var(--chic-about-text, var(--chic-ink));
  }

  .chic-page__about-aside-label {
    display: block;
    margin-bottom: 1.6rem;
    color: var(--chic-merlot);
    font-size: 1.05rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.18em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .chic-page__about-aside-rule {
    display: block;
    width: 4.2rem;
    height: 0.1rem;
    margin-bottom: 2.2rem;
    background: var(--chic-cocoa);
  }

  .chic-page__about-script {
    max-width: 20rem;
    margin: 0;
    color: var(--chic-cocoa);
    font-family: "Snell Roundhand", "Apple Chancery", "Segoe Script", cursive;
    font-size: clamp(2.8rem, 2.8vw, 3.4rem);
    line-height: 1.05;
  }

  .chic-page__about-copy {
    max-width: 78rem;
    color: var(--chic-about-text, var(--chic-ink));
    text-align: var(--chic-about-align, left);
  }

  .chic-page__about-lead {
    margin-top: 0;
    color: var(--chic-ink);
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 3.2vw, 4.8rem);
    font-weight: var(--chic-serif-weight);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .chic-page__about-copy p {
    max-width: 78rem;
    margin: 0 0 clamp(2.4rem, 3vw, 3.2rem);
    color: var(--chic-muted);
    font-size: clamp(1.55rem, 1.2vw, 1.75rem);
    line-height: 1.85;
  }

  .chic-page__about-copy p:last-child {
    margin-bottom: 0;
  }

  .chic-page__about-quote {
    margin: clamp(4.2rem, 5vw, 5.8rem) 0;
    padding: clamp(2.6rem, 3vw, 3.8rem) 0 clamp(2.6rem, 3vw, 3.8rem) clamp(2.4rem, 3vw, 3.6rem);
    border-left: 1px solid var(--chic-cocoa);
    color: var(--chic-ink);
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 3.4vw, 4.8rem);
    font-weight: var(--chic-serif-weight);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .chic-page__about-closing {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: clamp(4.2rem, 5vw, 5.8rem);
  }

  .chic-page__about-closing span {
    flex: 0 0 7.2rem;
    height: 0.1rem;
    background: rgba(91, 44, 47, 0.18);
  }

  .chic-page__about-closing em {
    color: var(--chic-merlot);
    font-family: "Snell Roundhand", "Apple Chancery", "Segoe Script", cursive;
    font-size: clamp(2.9rem, 3vw, 3.6rem);
    font-style: normal;
    line-height: 1.1;
  }

  .chic-page__reward {
    max-width: 78rem;
    margin: 4rem auto 0;
    padding: 3.2rem;
    text-align: left;
  }

  .chic-page__reward .button {
    margin-top: 2rem;
  }

  @media screen and (max-width: 749px) {
    .chic-page__tabs,
    .chic-page__faq-layout {
      grid-template-columns: 1fr;
    }

    .chic-page__faq-layout aside {
      position: static;
    }

    .chic-page__about-hero,
    .chic-page__about-layout {
      grid-template-columns: 1fr;
      gap: 3.4rem;
    }

    .chic-page__masthead--about .chic-heading {
      font-size: clamp(5.2rem, 17vw, 6.8rem);
    }

    .chic-page__about-aside {
      position: static;
    }

    .chic-page__about-script {
      max-width: none;
      font-size: 2.8rem;
    }

    .chic-page__about-quote {
      padding-left: 2rem;
      font-size: clamp(2.8rem, 10vw, 3.6rem);
    }

    .chic-page__about-closing {
      align-items: flex-start;
      gap: 1.4rem;
    }

    .chic-page__about-closing span {
      flex-basis: 4.8rem;
      margin-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic page content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "About Us page"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "about_intro",
      "label": "Intro",
      "default": "Some mornings you wake up soft. Some mornings you wake up fire. Your nails should be able to keep up."
    },
    {
      "type": "text",
      "id": "about_aside_label",
      "label": "Side label",
      "default": "For You"
    },
    {
      "type": "textarea",
      "id": "about_script",
      "label": "Script accent",
      "default": "made for\nevery version\nof you."
    },
    {
      "type": "textarea",
