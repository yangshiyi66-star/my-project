<section class="chic-reviews color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="chic-reviews__head">
      <h2 class="chic-section-title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.review_link != blank %}
        <a class="chic-reviews__write" href="{{ section.settings.review_link }}">{{ section.settings.review_link_label | escape }}</a>
      {% endif %}
    </div>

    <chic-reviews-carousel class="chic-reviews__viewport">
      <button type="button" class="chic-reviews__arrow chic-reviews__arrow--prev" data-dir="-1" aria-label="Previous">&#8249;</button>
      <div class="chic-reviews__row" data-track>
        {% for block in section.blocks %}
          <article class="chic-review chic-card" {{ block.shopify_attributes }}>
            <div class="chic-review__body">
              <div class="chic-review__topline">
                <div class="chic-review__stars" aria-label="{{ block.settings.rating }} / 5">
                  {% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}<span class="is-empty">★</span>{% endif %}{% endfor %}
                </div>
                {% if block.settings.date != blank %}<span class="chic-review__date">{{ block.settings.date | escape }}</span>{% endif %}
              </div>
              <div class="chic-review__buyer">
                <span class="chic-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 | upcase }}</span>
                <strong class="chic-review__name">{{ block.settings.name | escape }}</strong>
                <span class="chic-review__verified">Verified Buyer</span>
              </div>
              {% if block.settings.image != blank %}
                <div class="chic-review__product">
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="160" height="160">
                  <span>Zora Nails</span>
                </div>
              {% endif %}
              <p class="chic-review__quote">{{ block.settings.quote | escape }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
      <button type="button" class="chic-reviews__arrow chic-reviews__arrow--next" data-dir="1" aria-label="Next">&#8250;</button>
    </chic-reviews-carousel>
  </div>
</section>

{% stylesheet %}
  .chic-reviews {
    padding: clamp(5.2rem, 6vw, 8.8rem) 0;
  }

  .chic-reviews .page-width {
    max-width: none;
    padding-right: clamp(1.6rem, 2vw, 3.8rem);
    padding-left: clamp(1.6rem, 2vw, 3.8rem);
  }

  .chic-reviews__head {
    position: relative;
    text-align: center;
    margin-bottom: clamp(3.2rem, 4vw, 5.2rem);
  }

  .chic-reviews__head .chic-section-title {
    font-family: var(--font-body-family);
    font-size: clamp(2.2rem, 2.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .chic-reviews__write {
    position: absolute;
    right: 0;
    bottom: 0.4rem;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    color: var(--chic-muted);
  }

  .chic-reviews__viewport {
    position: relative;
    display: block;
  }

  .chic-reviews__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2.4rem) / 2);
    gap: 2.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.8rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .chic-reviews__row::-webkit-scrollbar { display: none; }

  @media screen and (max-width: 989px) {
    .chic-reviews__row { grid-auto-columns: 72%; }
  }
  @media screen and (max-width: 749px) {
    .chic-reviews__row { grid-auto-columns: 88%; }
  }

  .chic-review {
    scroll-snap-align: start;
    overflow: hidden;
    min-height: clamp(26rem, 24vw, 38rem);
    padding: clamp(2.4rem, 3.2vw, 4.8rem);
    border-color: rgba(91, 44, 47, 0.13);
    background: rgba(255, 253, 252, 0.88);
  }

  .chic-review__body {
    display: grid;
    align-content: start;
    gap: clamp(1.4rem, 1.8vw, 2.4rem);
    height: 100%;
    text-align: left;
  }

  .chic-review__topline,
  .chic-review__buyer,
  .chic-review__product {
    display: flex;
    align-items: center;
  }

  .chic-review__topline {
    justify-content: space-between;
    gap: 1.6rem;
  }

  .chic-review__avatar {
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 3.2rem;
    border-radius: 50%;
    background: var(--chic-cocoa);
    color: var(--chic-white);
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .chic-review__buyer {
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
  }

  .chic-review__name {
    color: var(--chic-ink);
    font-size: clamp(1.6rem, 1.3vw, 2rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .chic-review__verified {
    color: #137b83;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .chic-review__verified::after {
    content: "✓";
    display: inline-grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    margin-left: 0.6rem;
    border-radius: 50%;
    background: #137b83;
    color: #fff;
    font-size: 1rem;
    line-height: 1;
  }

  .chic-review__date {
    color: rgba(53, 37, 34, 0.58);
    font-size: clamp(1.25rem, 1vw, 1.5rem);
    white-space: nowrap;
  }

  .chic-review__product {
    gap: 1.2rem;
    color: var(--chic-muted);
    font-size: 1.45rem;
  }

  .chic-review__product img {
    width: 5.6rem;
    height: 5.6rem;
    object-fit: cover;
    border: 1px solid var(--chic-border);
    border-radius: var(--chic-radius-xs);
  }

  .chic-review__quote {
    margin: 0;
    color: var(--chic-ink);
    font-size: clamp(1.8rem, 1.45vw, 2.4rem);
    line-height: 1.55;
  }

  .chic-review__stars {
    color: var(--chic-mauve);
    letter-spacing: 0.12em;
    font-size: clamp(2rem, 1.8vw, 3rem);
    line-height: 1;
  }
  .chic-review__stars .is-empty { opacity: 0.22; }

  .chic-reviews__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 4rem; height: 4rem;
    display: grid; place-items: center;
    background: #fff;
    border: 1px solid var(--chic-border);
    border-radius: 50%;
    font-size: 2rem; line-height: 1;
    color: var(--chic-ink);
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(26, 26, 26, 0.1);
  }
  .chic-reviews__arrow--prev { left: -1.2rem; }
  .chic-reviews__arrow--next { right: -1.2rem; }
  .chic-reviews__arrow[disabled] { opacity: 0.3; cursor: default; }

  @media screen and (max-width: 749px) {
    .chic-reviews__arrow { display: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    class ChicReviewsCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.querySelectorAll('.chic-reviews__arrow').forEach((btn) =>
          btn.addEventListener('click', () => this.scrollByDir(parseInt(btn.dataset.dir, 10)))
        );
        this.track.addEventListener('scroll', () => this.update(), { passive: true });
        this.update();
      }
      step() {
        var card = this.track.querySelector('.chic-review');
        var gap = parseFloat(window.getComputedStyle(this.track).columnGap) || 24;
        return card ? card.getBoundingClientRect().width + gap : 300;
      }
      scrollByDir(dir) {
        this.track.scrollBy({ left: dir * this.step(), behavior: 'smooth' });
      }
      update() {
        var prev = this.querySelector('.chic-reviews__arrow--prev');
        var next = this.querySelector('.chic-reviews__arrow--next');
        var max = this.track.scrollWidth - this.track.clientWidth - 2;
        if (prev) prev.toggleAttribute('disabled', this.track.scrollLeft <= 2);
        if (next) next.toggleAttribute('disabled', this.track.scrollLeft >= max);
      }
    }
    if (!customElements.get('chic-reviews-carousel')) customElements.define('chic-reviews-carousel', ChicReviewsCarousel);
  })();
</script>

{% schema %}
{
  "name": "Chic reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OUR REVIEWS" },
    { "type": "text", "id": "review_link_label", "label": "Write-review label", "default": "Write a review" },
    { "type": "url", "id": "review_link", "label": "Write-review link (needs a reviews app/page)" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Love these nails!" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chic reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Ashley R.", "date": "2026/1/19", "quote": "[DEMO] I love how these look! So natural and easy to apply.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Mia T.", "date": "2026/1/9", "quote": "[DEMO] One of my favorite sets ever. Subtle, cute, and trendy.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Sophia L.", "date": "2025/12/28", "quote": "[DEMO] So cool and unique! I have never seen nails like this before.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Tiana W.", "date": "2025/10/21", "quote": "[DEMO] I LOVE these nails. Made my birthday outfit even more special!", "rating": 5 } },
        { "type": "review", "settings": { "name": "Karin M.", "date": "2025/6/21", "quote": "[DEMO] Love these nails! High quality, no bending or cracking.", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
