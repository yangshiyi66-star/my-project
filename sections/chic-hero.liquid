{%- liquid
  assign hero_image = section.settings.image
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
-%}

<section class="chic-hero chic-hero--{{ section.settings.height }}" aria-label="{{ section.settings.visual_label | default: section.settings.heading | escape }}">
  <div class="chic-hero__media">
    {% if hero_image != blank %}
      <img
        src="{{ hero_image | image_url: width: 2400 }}"
        srcset="
          {{ hero_image | image_url: width: 900 }} 900w,
          {{ hero_image | image_url: width: 1400 }} 1400w,
          {{ hero_image | image_url: width: 2000 }} 2000w,
          {{ hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.visual_label | escape }}"
        width="2400"
        height="1350"
        loading="eager"
        fetchpriority="high"
      >
    {% else %}
      <img
        src="{{ 'zora-hero-banner.png' | asset_url }}"
        alt="{{ section.settings.visual_label | escape }}"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  {% if section.settings.button_label != blank %}
    <div class="page-width chic-hero__cta">
      <a class="button chic-hero__button" href="{{ button_link }}">
        {{ section.settings.button_label | escape }}
      </a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .chic-hero {
    position: relative;
    overflow: hidden;
    background: var(--chic-paper);
  }

  .chic-hero__media {
    position: relative;
    overflow: hidden;
    min-height: clamp(34rem, 36vw, 68rem);
    max-height: 74rem;
    aspect-ratio: 16 / 6.2;
  }

  .chic-hero__media img {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% + clamp(5.6rem, 4.6vw, 8.2rem));
    min-height: inherit;
    object-fit: cover;
    object-position: center bottom;
  }

  .chic-hero__cta {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: clamp(4.8rem, 5.5vw, 9.2rem);
    left: 0;
    pointer-events: none;
  }

  .chic-hero__button.button {
    min-width: 20rem;
    border-color: var(--chic-cocoa);
    background: var(--chic-cocoa);
    color: var(--chic-white);
    pointer-events: auto;
  }

  @media screen and (min-width: 990px) {
    .chic-hero__button.button {
      margin-left: clamp(0rem, 2vw, 2.4rem);
    }
  }

  @media screen and (max-width: 749px) {
    .chic-hero__media {
      min-height: 38rem;
      aspect-ratio: 4 / 3.6;
    }

    .chic-hero__media img {
      height: calc(100% + 5.2rem);
      object-position: 58% bottom;
    }

    .chic-hero__cta {
      bottom: 3.2rem;
    }

    .chic-hero__button.button {
      width: 100%;
    }
  }
{% endstylesheet %}

