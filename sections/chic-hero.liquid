{%- liquid
  assign hero_image = section.settings.image
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_button_link | default: routes.all_products_collection_url
-%}

<section class="chic-hero chic-hero--{{ section.settings.height }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="page-width chic-hero__inner">
    <div class="chic-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="chic-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="chic-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.script_note != blank %}
        <p class="chic-script-note">{{ section.settings.script_note | escape }}</p>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="chic-hero__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}

      <div class="chic-hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="button chic-hero__button" href="{{ button_link }}">
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a class="button button--secondary chic-hero__button-secondary" href="{{ secondary_link }}">
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {% endif %}
      </div>

      <dl class="chic-hero__meta">
        <div>
          <dt>{{ section.settings.meta_1_heading | escape }}</dt>
          <dd>{{ section.settings.meta_1_text | escape }}</dd>
        </div>
        <div>
          <dt>{{ section.settings.meta_2_heading | escape }}</dt>
          <dd>{{ section.settings.meta_2_text | escape }}</dd>
        </div>
        <div>
          <dt>{{ section.settings.meta_3_heading | escape }}</dt>
          <dd>{{ section.settings.meta_3_text | escape }}</dd>
        </div>
      </dl>
    </div>

    <div class="chic-hero__board" aria-label="{{ section.settings.visual_label | escape }}">
      <div class="chic-hero__panel chic-hero__panel--quote">
        <span class="chic-hero__mini">{{ section.settings.visual_kicker | escape }}</span>
        <h2>{{ section.settings.visual_heading | escape }}</h2>
        <p>{{ section.settings.visual_text | escape }}</p>
        <span class="chic-script-note">{{ section.settings.visual_script | escape }}</span>
      </div>

      <div class="chic-hero__panel chic-hero__panel--image">
        <span class="chic-hero__mini">{{ section.settings.product_kicker | escape }}</span>
        {% if hero_image != blank %}
          <img
            src="{{ hero_image | image_url: width: 980 }}"
            srcset="
              {{ hero_image | image_url: width: 420 }} 420w,
              {{ hero_image | image_url: width: 720 }} 720w,
              {{ hero_image | image_url: width: 980 }} 980w
            "
            sizes="(min-width: 990px) 38vw, calc(100vw - 48px)"
            alt="{{ section.settings.visual_label | escape }}"
            width="980"
            height="980"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          <img
            src="{{ 'chic-hero.jpg' | asset_url }}"
            alt="{{ section.settings.visual_label | escape }}"
            width="1680"
            height="700"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </div>

      <div class="chic-hero__panel chic-hero__panel--kit">
        <span>{{ section.settings.kit_1 | escape }}</span>
        <span>{{ section.settings.kit_2 | escape }}</span>
        <span>{{ section.settings.kit_3 | escape }}</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .chic-hero {
    position: relative;
    overflow: hidden;
    padding: 3.2rem 0 4.8rem;
    color: var(--chic-ink);
    background:
      linear-gradient(180deg, rgba(255,255,255,.18), transparent 100%),
      linear-gradient(135deg, var(--chic-warm-cream) 0%, var(--chic-paper) 48%, var(--chic-paper-2) 100%);
  }

  .chic-hero::before {
    content: "";
    position: absolute;
    inset: auto -8rem -16rem auto;
    width: 34rem;
    height: 34rem;
    border: 1px solid var(--chic-line);
    border-radius: 50%;
    background: rgba(255, 253, 252, 0.42);
    filter: blur(0.2px);
    pointer-events: none;
  }

  .chic-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(2.4rem, 4vw, 4.8rem);
    align-items: start;
  }

  .chic-hero__copy {
    padding-top: clamp(1.6rem, 3vw, 3.2rem);
  }

  .chic-hero__eyebrow,
  .chic-hero__mini {
    margin: 0 0 1rem;
    color: var(--chic-merlot);
    font-size: 1rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .chic-hero__heading {
    max-width: 54rem;
    margin: 0 0 1.2rem;
    color: var(--chic-ink);
    font-family: var(--font-heading-family);
    font-size: clamp(5.8rem, 8vw, 12rem);
    font-weight: var(--chic-serif-weight);
    letter-spacing: 0;
    line-height: 0.84;
  }

  .chic-hero__subheading {
    max-width: 40rem;
    margin: 0 0 2.4rem;
    color: var(--chic-muted);
    font-size: 1.58rem;
    line-height: 1.58;
  }

  .chic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
  }

  .chic-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
    max-width: 45rem;
    margin: 3.4rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--chic-line);
  }

  .chic-hero__meta dt {
    color: var(--chic-cocoa);
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    line-height: 0.98;
  }

  .chic-hero__meta dd {
    margin: 0.5rem 0 0;
    color: var(--chic-muted);
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .chic-hero__board {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-rows: 22rem 24rem 12rem;
    gap: 1.6rem;
    min-height: 58rem;
  }

  .chic-hero__panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--chic-line-strong);
    border-radius: var(--chic-radius-md);
    background: rgba(255, 253, 252, 0.78);
    box-shadow: var(--chic-shadow-soft);
  }

  .chic-hero__panel::after {
    content: "";
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(91, 44, 47, 0.07);
    border-radius: calc(var(--chic-radius-md) - 0.3rem);
    pointer-events: none;
  }

  .chic-hero__panel--quote {
    grid-column: 1;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.8rem;
    background:
      linear-gradient(180deg, rgba(246, 239, 230, 0.82), rgba(255, 253, 252, 0.78)),
      radial-gradient(circle at 16% 20%, rgba(234, 193, 178, 0.42), transparent 24%);
  }

  .chic-hero__panel--quote .chic-hero__mini {
    margin-bottom: auto;
  }

  .chic-hero__panel--quote h2 {
    max-width: 34rem;
    margin: 0 0 1.2rem;
    color: var(--chic-cocoa);
    font-family: var(--font-heading-family);
    font-size: clamp(3.8rem, 4vw, 5.8rem);
    font-weight: var(--chic-serif-weight);
    letter-spacing: 0;
    line-height: 0.92;
  }

  .chic-hero__panel--quote p {
    max-width: 28rem;
    margin: 0;
    color: var(--chic-muted);
    font-size: 1.4rem;
    line-height: 1.55;
  }

  .chic-hero__panel--image {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.2rem 2rem;
    background:
      radial-gradient(circle at 72% 16%, rgba(255,255,255,.92) 0 8%, transparent 8.4%),
      linear-gradient(160deg, rgba(255,255,255,.88), rgba(239,231,222,.9));
  }

  .chic-hero__panel--image img {
    width: 100%;
    height: 100%;
    max-height: 39rem;
    object-fit: cover;
    object-position: center;
    border-radius: var(--chic-radius-sm);
  }

  .chic-hero__panel--kit {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 0;
    background: var(--chic-cocoa);
  }

  .chic-hero__panel--kit span {
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: 1.6rem;
    color: var(--chic-cocoa);
    background: rgba(255, 253, 252, 0.92);
    font-size: 1.1rem;
    font-weight: var(--chic-button-weight);
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .chic-hero__inner {
      grid-template-columns: 1fr;
    }

    .chic-hero__board {
      grid-template-rows: auto;
      min-height: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .chic-hero {
      padding: 2.4rem 0 3.2rem;
    }

    .chic-hero__heading {
      font-size: clamp(5.2rem, 18vw, 7.4rem);
    }

    .chic-hero__meta,
    .chic-hero__board,
    .chic-hero__panel--kit {
      grid-template-columns: 1fr;
    }

    .chic-hero__panel--quote,
    .chic-hero__panel--image,
    .chic-hero__panel--kit {
      grid-column: auto;
      grid-row: auto;
    }

    .chic-hero__panel--quote {
      min-height: 34rem;
    }

    .chic-hero__panel--image img {
      max-height: 30rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero visual image"
    },
    {
      "type": "text",
      "id": "eyebrow",
