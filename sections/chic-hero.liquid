{%- liquid
  assign bg = section.settings.image
-%}
<section class="chic-hero chic-hero--{{ section.settings.height }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="chic-hero__media">
    {% if bg != blank %}
      <img src="{{ bg | image_url: width: 2400 }}" alt="" width="2400" height="1000" loading="eager" fetchpriority="high">
    {% else %}
      <img src="{{ 'chic-hero.jpg' | asset_url }}" alt="" width="1680" height="700" loading="eager" fetchpriority="high">
    {% endif %}
    <span class="chic-hero__scrim" aria-hidden="true"></span>
  </div>

  <div class="page-width chic-hero__inner">
    <div class="chic-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="chic-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="chic-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="chic-hero__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button chic-hero__button" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .chic-hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  .chic-hero--medium { min-height: 56vh; }
  .chic-hero--large { min-height: 72vh; }
  .chic-hero--full { min-height: 88vh; }

  .chic-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chic-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .chic-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(120, 70, 80, 0.55) 0%, rgba(120, 70, 80, 0.18) 38%, rgba(120, 70, 80, 0) 62%);
  }

  .chic-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .chic-hero__content {
    max-width: 42rem;
    padding: 4rem 0;
  }

  .chic-hero__eyebrow {
    margin: 0 0 1.2rem;
    font-size: 1.3rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: var(--chic-ui-weight);
  }

  .chic-hero__heading {
    margin: 0 0 1.4rem;
    font-family: var(--font-heading-family);
    font-size: clamp(4.4rem, 7vw, 8rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .chic-hero__subheading {
    margin-bottom: 2.4rem;
    font-size: 1.6rem;
    line-height: 1.5;
    max-width: 34rem;
  }

  .chic-hero__button.button {
    --color-button: 255, 255, 255;
    color: var(--chic-ink);
    background: #fff;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .chic-hero--medium,
    .chic-hero--large,
    .chic-hero--full { min-height: 64vh; }

    .chic-hero__media img { object-position: 72% center; }

    .chic-hero__scrim {
      background: linear-gradient(180deg, rgba(120, 70, 80, 0.15) 0%, rgba(120, 70, 80, 0.55) 100%);
    }

    .chic-hero__content {
      max-width: 100%;
      padding: 3rem 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (leave empty to use built-in placeholder)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE NEXT DROP IS HERE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRESS-ON NAILS"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Salon-quality nails, ready in minutes. Made to match your mood.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    { "name": "Chic hero" }
  ]
}
{% endschema %}
