<section
  id="chic-product-details"
  class="chic-product-detail chic-steps color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.subheading != blank
    -%}
      <div class="chic-steps__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="chic-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="chic-section-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="chic-copy chic-steps__intro rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign step_count = 0
      for block in section.blocks
        if block.type == 'step'
          assign step_count = step_count | plus: 1
        endif
      endfor
    -%}

    {%- if step_count > 0 -%}
      <ol
        class="chic-steps__grid chic-grid chic-grid--{{ section.settings.columns_desktop }}"
        style="list-style:none;margin:0;padding:0;"
      >
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_index = step_index | plus: 1 -%}
            <li class="chic-card chic-step" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="chic-step__media">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 22vw, 50vw',
                      widths: '300, 400, 600, 800',
                      class: 'chic-step__img'
                  }}
                </div>
              {%- elsif section.settings.show_image_frame -%}
                <span class="chic-placeholder chic-step__media"></span>
              {%- endif -%}

              <div class="chic-step__body">
                {%- if section.settings.show_numbers -%}
                  <span class="chic-step__num" aria-hidden="true">
                    {{- step_index | prepend: '0' | slice: -2, 2 -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <strong class="chic-step__title">{{ block.settings.heading }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="chic-step__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="chic-steps__cta">
        <a
          class="button button--secondary"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .chic-steps {
    padding: 5.6rem 0;
  }

  .chic-steps__head {
    max-width: 64rem;
    margin: 0 auto 3.6rem;
    text-align: center;
  }

  .chic-steps__head .chic-eyebrow {
    text-align: center;
  }

  .chic-steps__intro {
    margin-top: 1.2rem;
  }

  .chic-steps__grid {
    display: grid;
    gap: 0.8rem;
  }

  .chic-step {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chic-step__media {
    aspect-ratio: 4 / 3;
    margin: 0;
    border: 0;
  }

  .chic-step__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chic-step__body {
    padding: 2rem 2rem 2.4rem;
  }

  .chic-step__num {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: var(--chic-serif-weight);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--chic-mauve);
  }

  .chic-step__title {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--chic-ink);
    font-size: 1.25rem;
    font-weight: var(--chic-ui-weight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chic-step__text {
    margin: 0;
    color: var(--chic-muted);
    font-size: 1.45rem;
    line-height: 1.55;
  }

  .chic-steps__cta {
    margin-top: 3.2rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .chic-steps {
      padding: 4rem 0;
    }

    .chic-step__body {
      padding: 1.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic application steps",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EASY AT HOME"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW TO APPLY"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting text",
      "default": "<p>Salon-quality nails in about 10 minutes, no appointment needed.</p>"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image_frame",
      "label": "Show image placeholder when empty",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Describe this step in one short, reassuring sentence."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Chic application steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Prep",
            "text": "Clean and buff each nail, then push back cuticles for a smooth base."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Size",
            "text": "Match each press-on to your natural nail and set them out in order."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Apply",
            "text": "Add a thin layer of glue or a sticky tab to the press-on and your nail."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Press",
            "text": "Press firmly for 15 seconds and avoid water for the first hour."
          }
        }
      ]
    }
  ]
}
{% endschema %}
